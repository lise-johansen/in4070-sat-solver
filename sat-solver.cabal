cabal-version:      3.0
name:               sat-solver
version:            0.1.0.0
synopsis:           DPLL SAT solver for IN4070 Oblig 3
build-type:         Simple

common warnings
    ghc-options:      -Wall

library
    import:           warnings
    exposed-modules:  Solver, Syntax, Testing
    build-depends:    base >=4 && <5, containers
    hs-source-dirs:   src
    default-language: Haskell2010

executable sat-solver
    import:           warnings
    main-is:          Main.hs
    -- -rtsopts allows `cabal run sat-solver -- +RTS -s` for memory and GC statistics.
    -- -M8g caps the heap at 8 GB, so the scaling run stops cleanly (app/Main.hs).
    ghc-options:      -rtsopts "-with-rtsopts=-M8g"
    build-depends:    base >=4 && <5, sat-solver, containers
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite sat-solver-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    build-depends:    base >=4 && <5, sat-solver, containers, tasty, tasty-hunit
    hs-source-dirs:   tests
    default-language: Haskell2010
